<!DOCTYPE html>
<html>
<head>
    <title>Make an Offer</title>
    <link rel="stylesheet" href="/css/form.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="/js/form.js"></script>
    <script>
        $(document).ready(function() {
            // Connect to WebSocket
            var socket = new WebSocket("ws://" + location.hostname + ":" + location.port + "/ws");

            socket.onmessage = function(event) {
                var message = JSON.parse(event.data);
                if (message.type === "updatePrice" && message.itemId === {{product.id}}) {
                    $("#product-price").text("$" + message.price.toFixed(2));
                }
            };
        });
    </script>
</head>
<body>
<div class="container">
    <h1>Make an Offer for {{product.name}}</h1>

    <button class="offer-btn">Make an Offer</button>

    <form id="offer-form" style="display:none;">
        <div class="form-item">
            <label class="form-label" for="name-input">Name</label>
            <input class="form-input" id="name-input" name="name" type="text" required>
        </div>

        <div class="form-item">
            <label class="form-label" for="email-input">Email</label>
            <input class="form-input" id="email-input" name="email" type="email" required>
        </div>

        <div class="form-item">
            <label class="form-label" for="amount-input">Offer Amount</label>
            <input class="form-input" id="amount-input" name="amount" type="number" min="1" required>
        </div>

        <input type="hidden" id="id-input" name="id" value="{{product.id}}">

        <button class="form-button" type="submit">Submit Offer</button>
    </form>
</div>
</body>
</html>
